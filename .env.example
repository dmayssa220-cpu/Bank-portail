# Copier ce fichier en .env et adapter les valeurs avant de lancer docker-compose

POSTGRES_DB=bankdb
POSTGRES_USER=bankuser
POSTGRES_PASSWORD=bankpassword

JWT_KEY=change-this-to-a-long-random-secret-in-production

ASPNETCORE_ENVIRONMENT=Development

# --- Odoo Community (ERP) ---
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoopassword
# Renseignés APRES avoir créé la base Odoo via l'assistant web (étape 3 du guide) :
ODOO_URL=http://odoo:8069
ODOO_DATABASE=bankportal
ODOO_USERNAME=admin
ODOO_API_PASSWORD=admin
