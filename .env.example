# Copier ce fichier en .env et adapter les valeurs avant de lancer docker-compose

POSTGRES_DB=bankdb
POSTGRES_USER=bankuser
POSTGRES_PASSWORD=bankpassword

JWT_KEY=change-this-to-a-long-random-secret-in-production

ASPNETCORE_ENVIRONMENT=Development

# --- Odoo Community (ERP) ---
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=odoopassword
# Renseignés APRES avoir créé la base Odoo via l'assistant web (étape 3 du guide) :
ODOO_URL=http://odoo:8069
ODOO_DATABASE=bankportal
ODOO_USERNAME=admin
ODOO_API_PASSWORD=admin

# --- Ollama (chatbot IA local, gratuit) ---
OLLAMA_URL=http://ollama:11434
# Modèle compact multilingue pour les machines avec peu de mémoire :
OLLAMA_MODEL=qwen2.5:0.5b

# --- RabbitMQ (bus d'événements) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# --- Email (via MailHog, serveur SMTP factice gratuit et local) ---
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_FROM=notifications@mabanque.local

# --- Redis (cache + jetons 2FA temporaires) ---
REDIS_CONNECTION=redis:6379
